# Server
PORT=8080

# Security (required)
API_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/backend_porto?sslmode=disable

# Redis (required for refresh tokens)
REDIS_URL=redis://localhost:6379/0

# Auth (required)
JWT_SECRET=
ADMIN_EMAIL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
FRONTEND_URL=http://localhost:3000

# S3 Storage (required)
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=portfolio
